{
  "name": "@gelatinbookings/partner-sdk",
  "version": "0.1.0-alpha.5",
  "description": "Typed, dependency-free client for Gelatin's partner booking API",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "openapi",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./budget": {
      "types": "./dist/budget.d.ts",
      "import": "./dist/budget.js"
    },
    "./places": {
      "types": "./dist/places.d.ts",
      "import": "./dist/places.js"
    },
    "./genres": {
      "types": "./dist/genres.d.ts",
      "import": "./dist/genres.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.examples.json"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5",
    "vitest": "^4.1.11",
    "@types/node": "^22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gelatinbookings/gelatin-partner-sdk.git"
  },
  "engines": {
    "node": ">=20"
  }
}
