{
  "name": "gelatin-partner-nextjs-example",
  "version": "0.1.0",
  "private": true,
  "description": "A complete Next.js partner site that books Gelatin DJs through the partner API",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@gelatinbookings/partner-sdk": "github:gelatinbookings/gelatin-partner-sdk#v0.1.0-alpha.2",
    "@stripe/stripe-js": "9.4.0",
    "next": "16.3.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.9"
  }
}
