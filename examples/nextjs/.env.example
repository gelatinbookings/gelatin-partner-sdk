# Copy to .env.local and fill in. Every value stays on the server.

# Gelatin sandbox. Live is https://www.gelatinbookings.com (use www: the bare domain redirects).
GELATIN_API_BASE_URL=https://staging.gelatinbookings.com
# Your partner slug, from Gelatin.
GELATIN_PARTNER_SLUG=
# Your sandbox key (gel_test_…), from Gelatin. Never commit it.
GELATIN_PARTNER_KEY=
# Your Gelatin booking page origin, from Gelatin. Launch links to anywhere else are refused.
GELATIN_PORTAL_ORIGINS=
# Where this app runs. Gelatin must have it registered as one of your return origins.
DEMO_PUBLIC_ORIGIN=http://127.0.0.1:3100
# Any password of 12+ characters; the example asks for it before showing anything.
DEMO_ACCESS_PASSWORD=
# Optional. The sandbox test DJs' password, from Gelatin. The testing guide shows
# it after sign-in so you can log in to Gelatin as a DJ and answer your booking.
DEMO_DJ_PASSWORD=
